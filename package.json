{
  "name": "sei-integrations-monorepo",
  "private": true,
  "type": "module",
  "description": "Monorepo de clientes TypeScript para integrações SEI e SIP da ANPD.",
  "license": "MIT",
  "author": {
    "name": "Luciano Édipo Pereira da Silva",
    "email": "luciano.psilva@anpd.gov.br",
    "url": "https://github.com/lucianoedipo"
  },
  "bugs": {
    "url": "https://gitlab.anpd.gov.br/publico/libs/sei-integrations/-/issues",
    "email": "desenvolvimento@anpd.gov.br"
  },
  "homepage": "https://gitlab.anpd.gov.br/publico/libs/sei-integrations#readme",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.anpd.gov.br/publico/libs/sei-integrations.git"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r --sort --if-present build",
    "clean": "pnpm -r --if-present clean",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "pnpm -r --if-present test",
    "test:coverage": "pnpm build && pnpm exec vitest run --config vitest.workspace.config.ts --coverage",
    "typecheck": "pnpm -r --if-present typecheck",
    "docs": "typedoc --entryPointStrategy expand packages/*/src/index.ts --out docs",
    "sonar": "set -a && [ -f .env ] && . ./.env; set +a; sonar-scanner -Dsonar.host.url=$SONAR_HOST_URL -Dsonar.token=$SONAR_TOKEN -Dsonar.projectVersion=$(node -p \"require('./packages/sip-client/package.json').version\")",
    "sonar:scan": "pnpm test:coverage && pnpm sonar",
    "smoke:sip": "tsx scripts/smoke-sip.ts",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "publish:sip": "pnpm --filter @anpdgovbr/sip-client publish --access public",
    "publish:sei": "echo \"@anpdgovbr/sei-client ainda esta reservado e private; publicacao desabilitada\"",
    "shared-scripts:init": "pnpm exec anpd-shared-scripts-init",
    "changeset:interactive": "pnpm exec anpd-changeset-interactive",
    "coverage:merge": "pnpm exec anpd-merge-cobertura",
    "env:check": "pnpm exec anpd-env-check --config env.check.json",
    "version:generate": "pnpm exec anpd-generate-version",
    "version:bump": "pnpm exec anpd-bump-version",
    "version:set-env": "pnpm exec anpd-set-version-env",
    "build:info": "pnpm exec anpd-generate-build-info",
    "public:copy:standalone": "pnpm exec anpd-copy-public-standalone",
    "dev:routes": "pnpm exec anpd-generate-dev-routes",
    "backlog:issues": "pnpm exec anpd-create-backlog-issues",
    "docs:serve": "pnpm exec anpd-typedoc --serve",
    "coverage:report": "pnpm run test:coverage && pnpm run coverage:merge"
  },
  "devDependencies": {
    "@anpdgovbr/shared-scripts": "^1.5.2",
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^9.39.4",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "^9.39.4",
    "fast-xml-parser": "catalog:",
    "globals": "^17.7.0",
    "prettier": "^3.9.4",
    "rimraf": "catalog:",
    "sonar-scanner": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typedoc": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "^8.63.0",
    "vitest": "catalog:"
  }
}
