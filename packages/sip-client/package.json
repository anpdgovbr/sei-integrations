{
  "name": "@anpdgovbr/sip-client",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Cliente TypeScript para integração SOAP com o SIP.",
  "license": "MIT",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./mappers": {
      "types": "./dist/mappers.d.ts",
      "import": "./dist/mappers.js",
      "require": "./dist/mappers.cjs"
    },
    "./soap": {
      "types": "./dist/soap.d.ts",
      "import": "./dist/soap.js",
      "require": "./dist/soap.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist coverage",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fast-xml-parser": "^5.9.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.4",
    "@vitest/coverage-v8": "^4.1.9",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.anpd.gov.br"
  },
  "sideEffects": false
}
